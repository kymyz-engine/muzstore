<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_5.1.xsd">

    <module name="store" package="com.axelor.apps.store.db"/>
    <entity name="StoreOrderItem">
        <many-to-one name="storeOrder" ref="com.axelor.apps.store.db.StoreOrder" required="true"/>
        <many-to-one name="product" ref="com.axelor.apps.store.db.StoreProduct" required="true"/>

        <integer name="quantity" required="true" default="1"/>
        <decimal name="price" required="true"/>
        <decimal name="subtotal" required="true"/>
    </entity>

</domain-models>