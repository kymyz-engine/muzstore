<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_5.1.xsd">

    <module name="store" package="com.axelor.apps.store.db"/>
    <entity name="StoreProduct">
        <string name="name" required="true" max="255"/>
        <string name="slug" required="true" unique="true" max="255"/>
        <string name="description" large="true"/>
        <string name="image" max="1024"/>

        <many-to-one name="category" ref="com.axelor.apps.store.db.Category" required="true"/>
        <many-to-one name="brand" ref="com.axelor.apps.store.db.Brand"/>

        <decimal name="price" required="true" min="0"/>
        <decimal name="oldPrice" min="0"/>
        <decimal name="pricePerDay" min="0"/>

        <decimal name="rating" min="0" max="5" default="0"/>
        <integer name="reviewCount" default="0"/>
        <boolean name="inStock" default="0"/>

        <string name="badge" selection="product.badge.selection" max="10"/>
        <one-to-many name="specs" ref="com.axelor.apps.store.db.ProductSpec" mappedBy="product"/>

        <unique-constraint columns="slug"/>
    </entity>

</domain-models>