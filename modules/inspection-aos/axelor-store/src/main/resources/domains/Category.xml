<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_5.1.xsd">

    <module name="store" package="com.axelor.apps.store.db"/>
    <entity name="Category">
        <string name="name" required="true" max="255"/>
        <string name="slug" required="true" unique="true" max="100"/>
        <string name="icon" max="10"/>

        <one-to-many name="products" ref="com.axelor.apps.store.db.StoreProduct" mappedBy="category"/>

        <unique-constraint columns="slug"/>
    </entity>

</domain-models>