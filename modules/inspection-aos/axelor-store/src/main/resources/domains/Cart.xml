<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_5.1.xsd">

    <module name="store" package="com.axelor.apps.store.db"/>
    <entity name="Cart">
        <many-to-one name="user" ref="com.axelor.auth.db.User" required="true" column="user_id"/>
        <one-to-many name="items" ref="com.axelor.apps.store.db.CartItem" mappedBy="cart"/>
        <string name="status" selection="cart.status.selection" default="active" max="20"/>
    </entity>

</domain-models>