<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_5.1.xsd">

    <grid name="spec-grid" title="Product spec" model="com.axelor.apps.store.db.ProductSpec">
        <field name="specKey"/>
        <field name="specValue"/>
    </grid>

    <form name="spec-form" title="Product spec" model="com.axelor.apps.store.db.ProductSpec" canNew="true" width="large">
        <panel>
            <field name="specKey"/>
            <field name="specValue"/>
        </panel>
    </form>

</object-views>