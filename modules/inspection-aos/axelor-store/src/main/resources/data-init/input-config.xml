            xsi:schemaLocation="http://axelor.com/xml/ns/data-import http://axelor.com/xml/ns/data-import/data-import_7.2.xsd">
    <input file="brands.csv" type="com.axelor.apps.store.db.Brand" search="self.id = :id"/>
